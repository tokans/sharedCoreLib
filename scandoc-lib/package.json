{
  "name": "@scandoc/core",
  "version": "1.0.0",
  "description": "Domain-agnostic scanned-document reading engine: OCR-noise text normalization, fuzzy vocabulary matching, confidence tiering, and a recognition seam. Used across the myLife suite (myHealth, myDocs, ...).",
  "author": "myLife suite",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ocr": {
      "import": {
        "types": "./dist/ocr/index.d.mts",
        "default": "./dist/ocr/index.mjs"
      },
      "require": {
        "types": "./dist/ocr/index.d.ts",
        "default": "./dist/ocr/index.js"
      }
    },
    "./docmodel": {
      "import": {
        "types": "./dist/docmodel/index.d.mts",
        "default": "./dist/docmodel/index.mjs"
      },
      "require": {
        "types": "./dist/docmodel/index.d.ts",
        "default": "./dist/docmodel/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "keywords": ["ocr", "scanned-document", "document-parser", "fuzzy-match", "confidence", "mylife"],
  "scripts": {
    "build": "tsup src/index.ts src/ocr/index.ts src/docmodel/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/ocr/index.ts src/docmodel/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "pdfjs-dist": "^4.0.0",
    "tesseract.js": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": { "optional": true },
    "tesseract.js": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^2.0.5"
  }
}
